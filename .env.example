# Firebase Configuration
# Copy this file to .env and fill in your Firebase credentials

# Firebase Web App Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:your-app-id

# Firebase Cloud Messaging - Web Push Certificate (VAPID Key)
# Generate this in Firebase Console: Project Settings > Cloud Messaging > Web Push certificates
FIREBASE_VAPID_KEY=your_vapid_public_key_here

# Note: Never commit the .env file to git!
# This file is automatically ignored by .gitignore
